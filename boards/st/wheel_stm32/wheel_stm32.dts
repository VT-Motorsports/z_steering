/dts-v1/;
#include <st/h7/stm32h753Xi.dtsi>
#include <st/h7/stm32h753vitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio-keys.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    model = "Wheel STM32H753VIT6 Custom Board";
    compatible = "st,stm32h753vi";

    chosen {
        zephyr,console = &usart3;
        zephyr,shell-uart = &usart3;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,dtcm = &dtcm;
        zephyr,canbus = &fdcan1;
    };

    leds {
        compatible = "gpio-leds";
        mcu_err_led: led_0 {
            gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;
            label = "MCU ERR LED";
        };
        mcu_stat_led: led_1 {
            gpios = <&gpiob 14 GPIO_ACTIVE_HIGH>;
            label = "MCU STAT LED";
        };
    };

    gpio_keys {
        compatible = "gpio-keys";
        
        /* 5 Pushbuttons & Toggle */
        btn_1: btn_1 {
            label = "Button 1";
            gpios = <&gpioe 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        btn_2: btn_2 {
            label = "Button 2";
            gpios = <&gpioe 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        btn_4: btn_4 {
            label = "Button 4";
            gpios = <&gpiob 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        btn_5: btn_5 {
            label = "Button 5";
            gpios = <&gpioe 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        btn_6: btn_6 {
            label = "Button 6";
            gpios = <&gpiod 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        toggle_up: toggle_up {
            label = "Toggle Switch Up";
            gpios = <&gpioe 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };

        /* Rotary Encoder Pushbuttons */
        bottom_rotary_btn: bottom_rotary_btn {
            /* U8 - mounted on the bottom */
            label = "Bottom Rotary Button";
            gpios = <&gpiob 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        top_rotary_btn: top_rotary_btn {
            /* U9 - mounted on the top */
            label = "Top Rotary Button";
            gpios = <&gpioc 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };

        /* Multiposition Switch Bits for BCD */
        bit1: bit1 {
            label = "Multi Switch Bit 1";
            gpios = <&gpioc 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        bit2: bit2 {
            label = "Multi Switch Bit 2";
            gpios = <&gpiob 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        bit4: bit4 {
            label = "Multi Switch Bit 4";
            gpios = <&gpiob 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        bit8: bit8 {
            label = "Multi Switch Bit 8";
            gpios = <&gpiob 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };

        /* Rotary Encoder A/B Channels (Mapped as simple GPIOs for now) */
        bottom_enc_a: bottom_enc_a {
            /* U8 - Bottom Rotary Channel A (LeftChannel net) */
            label = "Bottom Encoder A";
            gpios = <&gpioa 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        bottom_enc_b: bottom_enc_b {
            /* U8 - Bottom Rotary Channel B (RightChannel net) */
            label = "Bottom Encoder B";
            gpios = <&gpioa 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        top_enc_a: top_enc_a {
            /* U9 - Top Rotary Channel A (LeftChannel_2 net) */
            label = "Top Encoder A";
            gpios = <&gpioa 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
        top_enc_b: top_enc_b {
            /* U9 - Top Rotary Channel B (RightChannel_2 net) */
            label = "Top Encoder B";
            gpios = <&gpioa 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };

    aliases {
        led0 = &mcu_err_led;
        led1 = &mcu_stat_led;
        sw0 = &btn_1;
    };
};

&clk_hsi {
    status = "okay";
};

&pll {
    div-m = <16>;     
    mul-n = <240>;    
    div-p = <2>;      
    div-q = <2>;      
    div-r = <2>;      
    clocks = <&clk_hsi>;  
    status = "okay";
};

&pll2 {
    div-m = <32>;     
    mul-n = <120>;    
    div-p = <2>;      
    div-q = <3>;      
    div-r = <2>;      
    clocks = <&clk_hsi>;  
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(480)>;
    d1cpre = <1>;
    hpre = <2>;
    d1ppre = <2>;
    d2ppre1 = <2>;
    d2ppre2 = <2>;
    d3ppre = <2>;
};

/* Enable GPIO */
&gpioa { status = "okay"; };
&gpiob { status = "okay"; };
&gpioc { status = "okay"; };
&gpiod { status = "okay"; };
&gpioe { status = "okay"; };

&usart3 {
    pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

/* Updated to map the TCAN1042 transceiver */
&fdcan1 {
    clocks = <&rcc STM32_CLOCK_BUS_APB1_2 0x00000100>,
             <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
    pinctrl-0 = <&fdcan1_rx_pd0 &fdcan1_tx_pd1>;
    pinctrl-names = "default";
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(128)>;
        };
        slot0_partition: partition@20000 {
            label = "image-0";
            reg = <0x00020000 DT_SIZE_K(448)>;
        };
        slot1_partition: partition@90000 {
            label = "image-1";
            reg = <0x00090000 DT_SIZE_K(448)>;
        };
        storage_partition: partition@100000 {
            label = "storage";
            reg = <0x00100000 DT_SIZE_K(1024)>;
        };
    };
};